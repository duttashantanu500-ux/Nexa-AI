# Copy to .env.local for local development
# Never commit real secrets.

NEXT_PUBLIC_APP_URL=https://www.nexaiintelligence.online
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Token encryption (32-byte hex or base64)
NEXA_TOKEN_ENCRYPTION_KEY=

# OAuth apps
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Ideogram API (image generation)
IDEOGRAM_API_KEY=

# Cron protection (optional; Vercel cron still works without when unset)
CRON_SECRET=

# AI providers (at least one recommended)
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Ollama Cloud (https://ollama.com) — server-side only, never expose to browser
OLLAMA_API_KEY=
OLLAMA_API_BASE=https://ollama.com/api
OLLAMA_MODEL=gpt-oss:20b,gemma4:31b

# Nexa-owned / self-hosted model (OpenAI-compatible). Used when commercial APIs fail.
# Example: Ollama http://127.0.0.1:11434/v1 or your hosted endpoint
NEXA_MODEL_BASE_URL=
NEXA_MODEL_API_KEY=
NEXA_MODEL_NAME=nexa-default

# App
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Supabase (optional auth + durable OAuth token storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Encrypt connector tokens at rest
CONNECTOR_TOKEN_SECRET=

# Notion — SIMPLE path (internal integration API token from notion.so/my-integrations)
NOTION_INTERNAL_TOKEN=

# Notion — OAuth path (public integration; optional if using internal token)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

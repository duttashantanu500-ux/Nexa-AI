# App
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Supabase (required for storing each user's connector tokens)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Encrypt each user's connector tokens
CONNECTOR_TOKEN_SECRET=

# Notion — PUBLIC integration (OAuth). Each user connects their own account.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Do NOT use a shared workspace token for multi-user product.
# NOTION_INTERNAL_TOKEN is no longer used for agent runs.

# Slack OAuth (per-user)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# GitHub OAuth (per-user)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Dodo Payments (Pro subscription — $9/month)
# Create a monthly subscription product in Dodo dashboard, then set:
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRO_PRODUCT_ID=
# test_mode or live_mode
DODO_PAYMENTS_ENVIRONMENT=live_mode

# HubSpot OAuth (per-user CRM)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Buffer OAuth
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=

# Ideogram API (image generation)
IDEOGRAM_API_KEY=

# Cron protection (optional; Vercel cron still works without when unset)
CRON_SECRET=

# AI providers (at least one recommended)
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Nexa-owned / self-hosted model (OpenAI-compatible). Used when commercial APIs fail.
# Example: Ollama http://127.0.0.1:11434/v1 or your hosted endpoint
NEXA_MODEL_BASE_URL=
NEXA_MODEL_API_KEY=
NEXA_MODEL_NAME=nexa-default

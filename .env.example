# Select one cloud provider. If omitted, the first configured provider is used.
# When no cloud key is set, Nexa uses the browser engine automatically.
NEXA_AI_PROVIDER=auto
NEXA_AI_MODEL=
NEXA_AI_BASE_URL=

GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Ollama is local and does not require an API key.
OLLAMA_BASE_URL=http://localhost:11434

# App
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Supabase (auth + durable OAuth token storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Encrypt connector tokens at rest (required in production)
CONNECTOR_TOKEN_SECRET=

# Notion OAuth (public integration)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Slack OAuth (administrator)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# GitHub OAuth (administrator)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (administrator) — Gmail/Drive/Sheets/Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

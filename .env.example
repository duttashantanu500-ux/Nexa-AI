# App
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Supabase (required for storing each user's connector tokens)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Encrypt each user's connector tokens
CONNECTOR_TOKEN_SECRET=

# Notion — PUBLIC integration (OAuth). Each user connects their own account.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Do NOT use a shared workspace token for multi-user product.
# NOTION_INTERNAL_TOKEN is no longer used for agent runs.

# Slack OAuth (per-user)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# GitHub OAuth (per-user)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
